# --- Database (Neon / Postgres) ---
# Create a free database at https://neon.tech and paste the connection string.
DATABASE_URL=

# --- Auth.js ---
# Any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The single nutritionist account allowed to sign in.
NUTRITIONIST_EMAIL=nutricionista@exemplo.pt
NUTRITIONIST_PASSWORD=change-me

# --- Image upload (Vercel Blob) ---
# On Vercel: Storage -> create a Blob store; the token is injected automatically.
# For local dev: copy the token from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
